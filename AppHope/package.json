{
  "name": "hope-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HOPE - Hope for a Better Life : backend de donation et de suivi financier",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "tsx src/scripts/create-database.ts",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:donation": "tsx src/scripts/demo-donation.ts",
    "demo:monthly": "tsx src/scripts/demo-monthly.ts",
    "demo:project": "tsx src/scripts/demo-project.ts",
    "verify": "npm run typecheck && npm run prisma:validate && npm run migrate:deploy && npm run seed && npm test",
    "verify:full": "npm run verify && npm run demo:donation && npm run demo:monthly && npm run demo:project",
    "api": "tsx watch src/api/index.ts",
    "api:start": "tsx src/api/index.ts",
    "db:unpublish-demo": "tsx src/scripts/unpublish-demo-projects.ts",
    "e2e": "bash scripts/e2e.sh",
    "e2e:shots": "bash scripts/screenshots.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
