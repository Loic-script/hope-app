# ---------------------------------------------------------------------------
# Frontend HOPE : configuration
# Copier vers .env :  cp .env.example .env
#
# ATTENTION : tout ce qui commence par VITE_ est EMBARQUE DANS LE JAVASCRIPT
# envoye au navigateur. On n'y met donc jamais de secret : ni mot de passe,
# ni cle d'API privee, ni DATABASE_URL. Le frontend ne parle qu'a l'API HTTP.
# ---------------------------------------------------------------------------

# Adresse de l'API backend HOPE.
VITE_API_URL=http://localhost:3000/api
