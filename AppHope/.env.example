# ---------------------------------------------------------------------------
# HOPE - Hope for a Better Life : exemple de configuration
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
#   cp .env.example .env
# Le fichier .env ne doit JAMAIS etre commite (voir .gitignore).
# ---------------------------------------------------------------------------

# Connexion PostgreSQL principale
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/hope_donations"

# Base utilisee par les tests d'integration (elle est creee/reinitialisee
# automatiquement par la suite de tests : ne pas y stocker de donnees utiles).
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/hope_donations_test"

# Environnement d'execution : development | test | production
NODE_ENV="development"

# Niveau de log : debug | info | warn | error | silent
LOG_LEVEL="info"

# Devise par defaut de l'organisation (code ISO 4217)
DEFAULT_CURRENCY="MGA"

# Fournisseur de paiement par defaut.
# Phase 1 : uniquement "MOCK" (aucun appel reseau vers un vrai prestataire).
DEFAULT_PAYMENT_PROVIDER="MOCK"
