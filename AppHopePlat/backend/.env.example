# ============================================================
# HOPE - Modele de configuration backend
# Copier ce fichier vers .env puis renseigner les vraies valeurs.
#   cp .env.example .env
# ============================================================

# --- Base de donnees PostgreSQL ---
# Chez un hebergeur (Railway...), une seule adresse suffit : DATABASE_URL
# (Railway : ${{Postgres.DATABASE_URL}}). Elle remplace les DB_* ci-dessous.
# DB_SSL=true si la base est jointe par Internet plutot que par le reseau
# prive de l'hebergeur.
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hope_db
DB_USER=votre_utilisateur_postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# --- Authentification JWT ---
# Generer une cle longue et aleatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer_par_une_cle_longue_et_aleatoire
JWT_EXPIRES_IN=2h

# --- Serveur HTTP ---
# En production (NODE_ENV=production), JWT_SECRET doit compter 32 caracteres
# aleatoires au moins : le serveur refuse sinon de demarrer.
# SERVIR_FRONTEND : le serveur sert aussi frontend/dist (un seul service a
# heberger). false si le frontend est heberge ailleurs.
SERVIR_FRONTEND=true
PORT=3000
NODE_ENV=development

# --- Origine autorisee pour CORS (frontend Vite) ---
CORS_ORIGIN=http://localhost:5173

# --- Compte administrateur cree par le seed ---
# Le mot de passe n'est jamais stocke en clair : il est hashe avec bcrypt.
ADMIN_LOG=AdminHope
ADMIN_PASSWORD=remplacer_par_le_mot_de_passe_initial
BCRYPT_SALT_ROUNDS=12

# Coordonnees de l'equipe, affichees dans les fils d'assistance de la
# messagerie. Facultatives : laissees vides, elles ne s'affichent pas.
EQUIPE_EMAIL=
# L'adresse qui recoit les alertes d'erreur du serveur en production
# (au plus une par quart d'heure). Vide : celle de l'equipe (EQUIPE_EMAIL).
ALERTE_EMAIL=
EQUIPE_TELEPHONE=
EQUIPE_SITE=

# Le compte MVola de HOPE, affiche sur la page de paiement MVola du
# donateur (format 0341234567). Vide : le paiement MVola est indisponible.
HOPE_MVOLA_NUMERO=
HOPE_MVOLA_TITULAIRE=HOPE Madagascar

# Le compte Orange Money de HOPE (format 0321234567). Vide : indisponible.
HOPE_ORANGE_MONEY_NUMERO=
HOPE_ORANGE_MONEY_TITULAIRE=HOPE Madagascar

# Le compte bancaire de HOPE (virement local, depot, virement
# international). Vides : ces moyens le disent et restent indisponibles.
HOPE_BANQUE_NOM=
HOPE_BANQUE_AGENCE=
HOPE_BANQUE_TITULAIRE=HOPE Madagascar
# RIB malgache, 23 chiffres : banque (5) guichet (5) compte (11) cle (2)
HOPE_BANQUE_RIB=
# IBAN malgache (MG46 + le RIB) et code SWIFT/BIC de la banque
HOPE_BANQUE_IBAN=
HOPE_BANQUE_BIC=
HOPE_BANQUE_ADRESSE=

# Le bureau de HOPE, pour les dons en especes.
HOPE_BUREAU_ADRESSE=
HOPE_BUREAU_HORAIRES=

# Les transferts internationaux arrivent sur MVola, Orange Money ou le
# compte bancaire ; pour un retrait en especes au guichet (Western Union,
# MoneyGram, Ria), le nom de la personne qui retire les transferts en especes
# (Western Union, MoneyGram, Ria), et sa ville.
HOPE_RETRAIT_NOM=
HOPE_RETRAIT_VILLE=Antananarivo

# Dossier prive des photos des beneficiaires. Facultatif : par defaut
# backend/uploads/beneficiaires. Jamais sous uploads/medias, qui est
# servi publiquement sous /media.
BENEFICIAIRES_DOSSIER=

# --- Courriels : confirmation d'adresse, recus de don, mot de passe oublie,
# validation des comptes, messages du site ---
# Un serveur SMTP : Gmail, Brevo, Mailjet, Resend, une messagerie pro...
# Gmail : SMTP_HOST=smtp.gmail.com, port 587, SMTP_USER = l'adresse Gmail,
# SMTP_PASSWORD = un mot de passe d'application de CE compte (Compte Google >
# Securite > Validation en deux etapes > Mots de passe des applications).
# SMTP_SECURE=true pour le port 465. SMTP_FROM vide : "HOPE <SMTP_USER>".
# Verifier : npm run courriel:essai -- vous@exemple.com
# SMTP_HOST vide : en developpement, le courriel s'ecrit dans le journal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Stripe : le paiement par carte bancaire ---
# Les cles se trouvent dans le tableau de bord Stripe, "Developpeurs > Cles
# d'API". En essai, elles commencent par sk_test_ et pk_test_.
#   - la cle secrete ne quitte jamais le serveur ;
#   - la cle publique part dans le navigateur, c'est son role ;
#   - le secret du webhook signe les messages de Stripe (stripe listen, ou
#     "Developpeurs > Webhooks" en ligne). Sans lui, le serveur refuse les
#     messages : seule la page de retour confirmera le don.
# Vides, la page carte le dit et n'encaisse rien.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# L'adresse publique de reference du site (https://votre-domaine, sans
# www si le site se lit sans). Elle sert aux liens des courriels, au retour
# de Stripe apres une verification 3-D Secure, a robots.txt, au plan du
# site, aux adresses canoniques et aux apercus de partage ; l'autre forme
# (avec ou sans www) y est redirigee. Par defaut http://localhost:5173.
# En production, le serveur refuse de demarrer si elle manque, n'est pas
# en https ou designe localhost.
HOPE_SITE_URL=
