# ============================================================
# HOPE - Modele de configuration backend
# Copier ce fichier vers .env puis renseigner les vraies valeurs.
#   cp .env.example .env
# ============================================================

# --- Base de donnees PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hope_db
DB_USER=votre_utilisateur_postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# --- Authentification JWT ---
# Generer une cle longue et aleatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer_par_une_cle_longue_et_aleatoire
JWT_EXPIRES_IN=2h

# --- Serveur HTTP ---
PORT=3000
NODE_ENV=development

# --- Origine autorisee pour CORS (frontend Vite) ---
CORS_ORIGIN=http://localhost:5173

# --- Compte administrateur cree par le seed ---
# Le mot de passe n'est jamais stocke en clair : il est hashe avec bcrypt.
ADMIN_LOG=AdminHope
ADMIN_PASSWORD=remplacer_par_le_mot_de_passe_initial
BCRYPT_SALT_ROUNDS=12
