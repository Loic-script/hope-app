# Configuration du frontend HOPE.
# Seules les variables prefixees VITE_ sont exposees au navigateur.
# ATTENTION : ne jamais mettre ici de secret (mot de passe PostgreSQL, JWT_SECRET).
# "/api" : le serveur de developpement relaie vers le backend (vite.config.js),
# ce qui permet d'ouvrir la page depuis un telephone du meme reseau.
VITE_API_URL=/api

# Adresse du site public HOPE (bouton "Retour au site").
# Le site vitrine n'est pas encore developpe : par defaut on reste sur "/".
VITE_SITE_URL=/
