# ============================================================
# HOPE - Fichiers exclus du versionnement (racine du depot)
#
# Ce fichier protege l'ensemble du depot. Chaque sous-projet peut
# avoir son propre .gitignore, mais celui-ci doit rester la garantie
# qu'aucun secret ni dependance ne part sur GitHub.
# ============================================================

# --- Dependances ---
node_modules/

# --- Variables d'environnement ---
# Contiennent le mot de passe PostgreSQL et le secret JWT.
# NE JAMAIS COMMITER.
.env
.env.local
.env.*.local
!.env.example

# --- Builds ---
dist/
build/
*.tsbuildinfo

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*
logs/

# --- Cache des outils ---
.vite/
.cache/
coverage/

# --- Fichiers televerses par l'association ---
# Justificatifs et medias : donnees reelles, jamais versionnees.
backend/uploads/
**/backend/uploads/

# --- Editeurs et systemes d'exploitation ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Sources de travail deposees dans src/assets ---
# Photos brutes, exports de maquette et captures d'ecran : aucune n'est
# importee par le code, et elles pesent 12 Mo -- quatre fois le depot.
# Elles restent sur le disque, simplement hors du versionnement. Un
# visuel qui SERT a l'application est redimensionne, renomme, puis
# ajoute explicitement (git add -f) comme les autres assets suivis.
Capture d’écran*
Copie de WEBSITE HOPE*
*-unsplash.jpg
pexels-*
AppHopePlat/frontend/src/assets/COUVERTURE.jpg
